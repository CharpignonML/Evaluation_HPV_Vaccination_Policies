  theme_minimal()

ggtrends_tbl <- df_2010 %>%
  as_tibble() %>%
  mutate(Date = as.Date(Date))

ggtrends_tbl %>%
  time_decompose(n,
                 method = "stl",
                 frequency = "auto",
                 trend = "auto") %>%
  anomalize(remainder) %>%
  plot_anomaly_decomposition() +
  labs(title = "Anomalies recherches google",
       subtitle = "Method STL Decomposition")

anomalies <- ggtrends_tbl %>%
  time_decompose(n,
                 method = "stl",
                 frequency = "auto") %>%
  anomalize(remainder) %>%
  time_recompose() %>%
  filter(anomaly == "Yes")
anomalies %>% select(Date, observed, remainder, anomaly)

