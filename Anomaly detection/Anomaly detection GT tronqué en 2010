  geom_line(color = "indianred3", size = 1) +
  geom_smooth(method = "loess") +
  scale_x_date(date_labels = "%b/%Y") +
  labs(
    title = "Recherches ggtrends en lien avec vaccin HPV",
    subtitle = "2010 - 2026",
    x = "",
    y = "Recherches ggtrends"
