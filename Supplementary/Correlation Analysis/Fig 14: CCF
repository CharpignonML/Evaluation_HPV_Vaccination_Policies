### GOOGLE TRENDS = x et SNDS = y 

## Données SNDS

df_snds <- read.csv("/Users/charlottederogis/Desktop/Stage/données\ SNDS/table_hpv_dose_periode.csv")
#df_snds <- read.csv('C:/Users/i224125/Downloads/Evaluation_HPV_Vaccination_Policies-main/Evaluation_HPV_Vaccination_Policies-main/table_hpv_dose_periode.csv')

df_snds <- df_snds %>% 
  mutate(total = dose_1 + dose_2 + dose_3)

df_snds$Date <- as.Date(paste0("01/", df_snds$periode), format = "%d/%m/%Y")

df_snds <- df_snds %>% 
  dplyr::select(Date, total)

## Données google trends

df_ggtrends <- read.csv2("/Users/charlottederogis/Desktop/Stage/R/CSV/google\ trends/ggt\ total\ dates\ snds.csv")
#df_ggtrends <- read.csv2("C:/Users/i224125/Downloads/Evaluation_HPV_Vaccination_Policies-main/Evaluation_HPV_Vaccination_Policies-main/Data/ggt_total_dates_snds.csv")

df_ggtrends$Date <- as.Date(paste0(df_ggtrends$Date, "-01"), format = "%Y-%m-%d")

# transformation en time series

ts_gt <- ts(df_ggtrends$n[11:nrow(df_ggtrends)], start = c(2007, 07), frequency = 12)  # ou frequency = 1 si annuel
ts_snds <- ts(df_snds$total[2:nrow(df_snds)], start = c(2007, 07), frequency = 12)

# même dates
gt <- ts.intersect(ts_gt, ts_snds)[, "ts_gt"]
snds <- ts.intersect(ts_gt, ts_snds)[, "ts_snds"]

## plot time series
plot(cbind(gt, snds), yax.flip = TRUE)

# CCF 

# visual
folder_output <- "/Users/charlottederogis/Desktop/Stage/VF analyses/validés pour de vrai"

png(
  filename = file.path(folder_output, "CCF google trends SNDS.png"),
  width    = 10,
  height   = 6,
  units    = "in",
  res      = 300
)

oldpar <- par(mar = c(5, 4, 1, 2) + 0.1)
ccf(
  diff(gt),
  diff(snds),
  lag.max = 24,
  main = "",
  xlab = "Lag (in months)",
  ylab = "Cross-correlation between raw GT and SNDS data",
  xaxt = "n"
)
axis(
  1,
  at = seq(-24, 24, by = 2) / 12,
  labels = seq(-24, 24, by = 2)
)
par(oldpar)

dev.off()





## en mettant le signal SNDS sur une echelle de 0 à 100
# y_transforme(t) = [y_original(t) - ymin] / [ymax - ymin])

snds_norm <- (snds - min(snds, na.rm = TRUE)) / (max(snds, na.rm = TRUE) - min(snds, na.rm = TRUE))

# visual
oldpar <- par(mar = c(5, 4, 1, 2) + 0.1)

ccf(
  diff(gt),
  diff(snds_norm),
  lag.max = 24,
  main = "",
  xlab = "Lag (in months)",
  ylab="Cross-correlation between raw GT and scaled SNDS data",
  xaxt = "n"
)

axis(
  1,
  at = seq(-24, 24, by = 2) / 12,
  labels = seq(-24, 24, by = 2)
)

par(oldpar)

## En utilisant les signaux standardisés pour les deux séries 
## (pour cela, utiliser la formule 
##y_transforme(t) = [y_original(t) - moyenne de y_original sur la periode]/[ecart-type de y_original])

snds_stand <- (snds - mean(snds, na.rm = TRUE)) / sd(snds, na.rm = TRUE) 
gt_stand <- (gt - mean(gt, na.rm = TRUE)) / sd(gt, na.rm = TRUE)

# Visual
oldpar <- par(mar = c(5, 4, 1, 2) + 0.1)

ccf(
  diff(gt_stand),
  diff(snds_stand),
  lag.max = 24,
  main = "",
  xlab = "Lag (in months)",
  ylab="Cross-correlation between standardized GT and SNDS data",
  xaxt = "n"
)

axis(
  1,
  at = seq(-24, 24, by = 2) / 12,
  labels = seq(-24, 24, by = 2)
)

par(oldpar)
